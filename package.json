{
  "name": "obsidian-count-block",
  "version": "0.1.0",
  "description": "Editable plain-text blocks with live, configurable counts for Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "word-count",
    "character-count",
    "neis"
  ],
  "license": "MIT",
  "author": "lee-jongwoo",
  "homepage": "https://github.com/lee-jongwoo/count-block",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.10.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
